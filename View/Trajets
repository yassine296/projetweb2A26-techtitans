/* Grille responsive */
.cards-wrapper {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
  gap: 1.5rem;
  max-width: 1200px;
  margin: 0 auto;
}

/* Carte individuelle */
.card-container {
  background-color: #fff;
  border-radius: 12px;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  transition: transform 0.2s ease;
}

.card-container:hover {
  transform: translateY(-5px);
}

/* Info conducteur */
.driver-info {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.driver-pic {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid #e53935;
}

.driver-pseudo {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 600;
}

.rating {
  font-size: 0.9rem;
  color: #f39c12;
}

.trajet-content {
  display: flex;
  gap: 20px; /* Espace entre les colonnes */
}

.map-and-buttons {
  flex: 1;
  display: flex;
  flex-direction: column;
}


/* Détails trajets */
.trajets-dispo {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  font-size: 0.95rem;
  color: #444;
}

.trajets-dispo i {
  color: #e53935;
  margin-right: 8px;
  width: 20px;
  text-align: center;
}

.trajets-dispo div {
  display: flex;
  align-items: center;
}

/* Ligne prix + bouton */
.price-reserve {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 0.6rem;
  font-weight: bold;
  font-size: 20px;
}

.price-reserve .fas.fa-money-bill-wave {
  color: #2ecc71;
  margin-right: 6px;
  font-size: 20px;
}

.map-container {
  width: 250px;
  height: 200px;
  border-radius: 15px;
  margin-top: 15px;
  margin-bottom: 53px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background-image: url('maps.png');
  background-size: cover;
  background-position: center;
}

.buttons-container {
  display: flex;
  justify-content: flex-end; /* Aligne les boutons à droite */
  gap: 10px; /* Espacement entre les boutons */
}


/* Bouton réserver */
.book-btn {
  background-color: #ff3c3c;
  color: white;
  border: none;
  border-radius: 20px;
  padding: 10px 18px;
  font-weight: bold;
  font-size: 14px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  cursor: pointer;
  transition: all 0.3s ease;
}

.book-btn:hover {
  background-color: #c62828;
}


.price-reserve .fas.fa-car {
  color: white;
  margin-right: 6px;
}
